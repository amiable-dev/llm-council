{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query-answer.schema.json",
  "title": "Answer to a corpus query, returned by a model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "answer",
    "citations"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 20
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "supports"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "supports": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "$comment": "What the corpus could not answer. A gap is a finding \u2014 it names the next thing worth ingesting."
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Copied verbatim from the emitted envelope \u2014 binds this answer to its task."
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "human",
            "model-single",
            "model-panel"
          ]
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "class"
      ],
      "description": "Attestation of who answered; recorded in the C6 artifact, never in notes."
    },
    "proposer_overlap": {
      "enum": [
        true,
        false,
        "unknown"
      ],
      "description": "true when the answering supplier also produced the material under judgment."
    }
  },
  "$comment": "Every citation must resolve to a concept that was actually retrieved. An answer citing a note it was never shown is ungrounded, and that check is cheap and deterministic."
}
